<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#1976D2"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnAbout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="About Us  "
            android:textColor="#FFFFFF"
            android:padding="8dp"/>

        <TextView
            android:id="@+id/btnCourses"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Courses  "
            android:textColor="#FFFFFF"
            android:padding="8dp"/>

        <TextView
            android:id="@+id/btnFees"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fees  "
            android:textColor="#FFFFFF"
            android:padding="8dp"/>

        <TextView
            android:id="@+id/btnContact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contact"
            android:textColor="#FFFFFF"
            android:padding="8dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E8F5F0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Welcome to Pawsitive Pet Academy"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#12372A"
                android:gravity="center"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Established in 2023, Pawsitive Pet Academy provides training and education in pet care and animal training in Durban."
                android:gravity="center"
                android:layout_marginBottom="24dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Practical Skills"
                    android:textStyle="bold"
                    android:gravity="center"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Professional Learning"
                    android:textStyle="bold"
                    android:gravity="center"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="20dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Animal Care"
                    android:textStyle="bold"
                    android:gravity="center"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnExplore"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Explore Our Courses"
                android:backgroundTint="#12372A"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>